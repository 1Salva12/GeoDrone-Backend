PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=12h
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require
UPLOAD_DIR=./uploads
NODEODM_URL=http://localhost:3000
NODEODM_TOKEN=
NODEODM_OPTIONS=[{"name":"orthophoto-resolution","value":5},{"name":"dem-resolution","value":5},{"name":"dsm","value":true}]
CORS_ORIGIN=http://localhost:5173
